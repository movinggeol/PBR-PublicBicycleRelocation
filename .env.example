# 이 파일을 .env로 복사한 뒤 발급받은 키를 입력하세요. (.env는 Git에 포함되지 않습니다)

# TASHU Open API 키 — step0 tashu_api.py (https://bike.tashu.or.kr)
TASHU_API_KEY=

# TMAP API 키 — step3 main.py (https://tmapapi.tmapmobility.com)
API_KEY=

# (선택) 파이프라인 공통 설정 기본값 덮어쓰기
#PBR_NOW=2026-05-21 18
#PBR_PERIOD=25년 11월
#PBR_DURATION=_05_10
#PBR_RAW_FILE=data/raw_data/...csv
#PBR_DB_PATH=data/bike_system.db

# (선택) 모델 파라미터 — 기본값은 실측 실험으로 정했습니다 (docs/EXPERIMENTS.md)
#PBR_TARGET_Z=1.99          # 목표 재고 안전계수: target_qty = mu + z·sigma
#PBR_CLUSTER_GAMMA=3000     # 군집 목적함수의 거리 가중치
#PBR_CLUSTER_ALPHA=1
#PBR_CLUSTER_BETA=100

# (선택) 차량 운용 (docs/FLEET.md)
#PBR_FLEET_SIZE=21
#PBR_VEHICLES_PER_ROUND=10
#PBR_TIME_BUDGET_MINUTES=120

# (선택) TMAP 호출 제어 — 일일 한도가 있는 유료 API입니다 (docs/steps/step3_visualization.md)
#PBR_TMAP_MAX_CALLS=35      # 한 실행의 호출 상한. 넘으면 남은 경로는 직선으로 그립니다
#PBR_TMAP_MAX_VIA=100       # 한 번에 보낼 경유지 수 (엔드포인트 상한에 맞출 것)
#PBR_TMAP_URL=https://apis.openapi.sk.com/tmap/routes/routeSequential100
