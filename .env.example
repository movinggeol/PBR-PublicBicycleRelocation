# 이 파일을 .env로 복사한 뒤 발급받은 키를 입력하세요. (.env는 Git에 포함되지 않습니다)

# TASHU Open API 키 — step0 tashu_api.py (https://bike.tashu.or.kr)
TASHU_API_KEY=

# TMAP API 키 — step3 main.py (https://tmapapi.tmapmobility.com)
API_KEY=

# (선택) 파이프라인 공통 설정 기본값 덮어쓰기
#PBR_NOW=2026-05-21 18
#PBR_PERIOD=25년 11월
#PBR_DURATION=_05_10
#PBR_RAW_FILE=data/raw_data/...csv
#PBR_DB_PATH=data/bike_system.db
# 산출물(pp_data 등)과 기본 DB를 둘 데이터 루트(기본 data). DB는 PBR_DB_PATH가 없을 때
# <데이터 루트>/bike_system.db를 씁니다. 원천 입력의 기본값(PBR_RAW_FILE·PBR_WEATHER_FILE)은
# 따라오지 않습니다 — 다른 원천을 쓰려면 그 둘을 절대경로로 줍니다 (project_config.py DATA_ROOT)
#PBR_DATA_ROOT=data
# PBR_RUN_KIND(plan | experiment | probe)는 여기에 적지 않습니다 — run_pipeline.py --run-kind가
# 하위 단계에 내려보내는 값이라, .env에 적으면 선언을 잊은 모든 실행이 그 종류로 기록됩니다 (db.py)

# (선택) 모델 파라미터 — 기본값은 실측 실험으로 정했습니다 (docs/분석/EXPERIMENTS.md)
#PBR_TARGET_Z=1.99          # 목표 재고 안전계수: target_qty = mu + z·sigma
#PBR_CLUSTER_GAMMA=3000     # 군집 목적함수의 거리 가중치
#PBR_CLUSTER_ALPHA=1
#PBR_CLUSTER_BETA=100
#PBR_CLUSTER_SEED=42        # K-Medoids 초기화 씨앗. 바꾸면 군집이 달라집니다 — 조정할 값이 아니라
                            # 씨앗 잡음을 재 보는 값입니다 (run_pipeline.py --seed와 같음)

# (선택) 차량 운용 (docs/구현/FLEET.md)
# 두 대수 모두 웹 실행 폼이나 run_pipeline.py --fleet-size / --vehicles-per-round
# 로도 정할 수 있습니다 (각 1~99).
#PBR_FLEET_SIZE=21
#PBR_VEHICLES_PER_ROUND=21   # 회차당 투입 '상한'(기본 = 보유 대수).
                            # 실제 대수는 그 회차의 작업량이 정합니다(실측 12~16대).
                            # 보유 대수보다 크게 적으면 보유 대수로 잘립니다
#PBR_TIME_BUDGET_MINUTES=120
#PBR_ENFORCE_TIME_BUDGET=1  # 시간 예산을 제약으로 겁니다(기본 꺼짐). 넘길 작업 앞에서 멈추고
                            # depot으로 돌아와 남은 작업은 미집행. run_pipeline.py --enforce-time-budget와 같음
#PBR_VEHICLE_SPEED_KMPH=25   # 상수 속도(km/h). 실도로 모형을 끈 PBR_USE_ROAD_MODEL=0일 때만 계획의
                            # 이동시간에 쓰입니다 — 그때는 ILP와 VRP가 함께 쓰므로 한쪽만 바꿀 수 없습니다
#PBR_PICK_TIME_SEC=30       # 자전거 1대 싣는 시간(초) — 현장 확인 안 된 가정값
#PBR_DROP_TIME_SEC=30       # 자전거 1대 내리는 시간(초) — 소요시간의 20~30%를 차지

# (선택) 출발 리드 — 차가 회차 시작보다 몇 분 먼저 차고지를 떠나나 (docs/분석/EXPERIMENTS.md 51장 끝)
# 기본 30분(사용자 결정 2026-10-14): _05_10이면 04:30 출발. 계획 · 수요 창은 회차 시작 그대로이고,
# step3 지도의 교통량 시각과 현장 앱의 출발 · 완료 예정 시각만 당겨집니다
#PBR_DEPART_LEAD_MINUTES=30  # 0 = 회차 시작에 출발(원고 시절 재현용). 0 이상 300 미만만 받습니다

# (선택) 실도로 이동시간 모형 — 이동시간(초) = 고정비 + 직선km x 3600 / 속도
# 기본은 켜져 있습니다(게이트 A 채택). 계수 기본값은 판정값입니다: 평일 게이트 A(2026-09-15),
# 휴일 게이트 B(2026-10-04) (docs/분석/EXPERIMENTS.md 9장, project_config.py)
#PBR_USE_ROAD_MODEL=0       # 끄면 직선거리 ÷ PBR_VEHICLE_SPEED_KMPH. 켜기 1·true·yes·on, 끄기 0·false·no·off
                            # (그 밖의 값은 조용히 넘기지 않고 멈춥니다)
#PBR_ROAD_FIXED_SEC_WEEKDAY=320.4   # 평일 구간당 고정비(초). 옛 이름 PBR_ROAD_FIXED_SEC도 읽습니다
#PBR_ROAD_SPEED_KMPH_WEEKDAY=32.11  # 평일 거리비례 속도(km/h). 옛 이름 PBR_ROAD_SPEED_KMPH도 읽습니다
#PBR_ROAD_FIXED_SEC_HOLIDAY=309.5   # 휴일 구간당 고정비(초)
#PBR_ROAD_SPEED_KMPH_HOLIDAY=32.33  # 휴일 거리비례 속도(km/h)

# (선택) 회차당 필요 차량 추정 (docs/구현/FLEET.md)
#PBR_TRAVEL_MIN_PER_STATION=12.5  # 대여소 한 곳당 이동분 — 실측 10.2~13.0의 보수 쪽 값
#PBR_CLUSTER_IMBALANCE=1.4        # 최장/평균 차량 소요 여유 — 실측 1.28~1.51
#PBR_WANTED_VEHICLES_GEO=1        # 후보 집합의 기하로 이동거리를 추정합니다(기본 꺼짐).
                                  # 켜면 회차당 차량 수가 달라져 문서 수치가 무효가 됩니다

# (선택) 작업 대상 선정·군집 조정 — **실험으로 정한 값이 아니라 관행값입니다**
#PBR_REBAL_MIN_QTY=2          # |rebal_qty|가 이 값 이하인 대여소는 손대지 않습니다
#PBR_TOP_STATION_LIMIT=50     # Pick·Drop 각각 상위 몇 곳까지 볼지
#PBR_ADJUST_MAX_ITER=200      # 군집 조정 반복 상한
#PBR_ADJUST_BALANCE_OK=3      # 모든 군집의 |수급 합|이 이 값 이하면 만족
#PBR_ADJUST_BALANCE_LIMIT=5   # 이 값을 넘는 군집은 재조정 대상

# (선택) 그 밖의 운영 값 — 현장 확인이 안 된 값과 표시용 값입니다
#PBR_TARGET_QTY_UPPER_RATIO=1.5  # 목표 재고 상한 = 거치대 x 이 배수. 웹 실시간 대조도 같은 값을 씁니다
                                 # (docs/구현/steps/step0_raw.md)
#PBR_PICK_HARM_WARN_SHARE=0.05   # Pick 쪽 결품 증가가 Drop 쪽 이득의 이 몫을 넘을 때만 경고 (step4)
#PBR_MAP_TILES=OpenStreetMap     # 세 지도(군집·경로·재고)가 함께 쓰는 배경 타일(folium 이름)

# (선택) 요일 구분 — 휴일 = 주말 + 공휴일 (docs/구현/steps/step0_raw.md)
#PBR_DAY_TYPE=auto          # auto | weekday | holiday. auto는 대상일을 달력으로 판정
#PBR_TARGET_DATE=2026-09-25 # 계획 대상일(기본 오늘). auto 판정의 기준

# (선택) 계절 수준 보정 — 계획 대상 달 첫 N일로 배율을 구한다 (docs/분석/EXPERIMENTS.md 3장)
#PBR_WARMUP_DAYS=14         # 0이면 끔
#PBR_WARMUP_PERIOD=26년 03월 # 기본: 계획 대상일의 달

# (선택) 날씨 원천 — 기상자료개방포털 ASOS 시간자료(대전 지점 133)
# 웹 화면(실행 폼 위 날씨 상자)과 demand_model.py(날씨 피처 하네스)가 읽습니다.
# 없어도 파이프라인은 그대로 돕니다 — 날씨는 있으면 좋고 없어도 되는 입력입니다.
# 이 키는 기상청 API 허브(https://apihub.kma.go.kr) 키이고, 실시간 관측(kma_sfctm2)에
# 씁니다. 과거 자료는 키 없이 기상자료개방포털 CSV로 받습니다 — 받는 방법은
# docs/분석/WEATHER.md 1장, data/raw_data/날씨/설명.txt.
#APIHUN_KMA_TYPE01_KEY=발급받은키

# 날씨 원천 경로입니다. 파일 하나여도 되고 디렉터리여도 됩니다(그 안의 CSV를 모두 읽습니다).
#PBR_WEATHER_FILE=data/raw_data/날씨

# (선택) TMAP 호출 제어 — 일일 호출 한도가 있는 무료 API입니다. 유료 요금제는 신청하지 않아
# 한도를 넘어도 요금이 붙지 않고 429로 거절될 뿐입니다 (docs/구현/steps/step3_visualization.md)
# 엔드포인트는 자동으로 고릅니다: routeSequential30을 먼저 쓰고, 일일 한도를
# 소진하면 routeSequential100, 그다음 routeSequential200으로 전환합니다
# (한도가 따로 잡힙니다 — 30은 100건/일, 100은 50건/일, 200은 20건/일).
# 공식 이름은 '다중 경유지 안내'입니다('경유지 최적화'는 별도 계약이 필요한 다른 API).
#PBR_TMAP_MAX_CALLS=35      # 한 실행의 호출 상한. 끝까지 못 부를 회차는 그리지 않고 건너뜁니다(1.26.222)
#PBR_TMAP_MAX_VIA=30        # 경유지 상한 강제(비우면 엔드포인트별 상한 30/100/200을 따름)
#PBR_TMAP_URL=https://apis.openapi.sk.com/tmap/routes/routeSequential100  # 지정 시 폴백 없음
#PBR_TMAP_SEARCH_OPTION=2   # 2 = 교통최적+최단시간. 재배치는 요금이 아니라 시간이 목적입니다
#PBR_TMAP_CAR_TYPE=1        # 통행료 계산용 차종(1 승용차). 재배치 차량은 소형 트럭·밴입니다
