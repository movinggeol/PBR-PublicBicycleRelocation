# 이 파일을 .env로 복사한 뒤 발급받은 키를 입력하세요. (.env는 Git에 포함되지 않습니다)

# TASHU Open API 키 — step0 tashu_api.py (https://bike.tashu.or.kr)
TASHU_API_KEY=

# TMAP API 키 — step3 main.py (https://tmapapi.tmapmobility.com)
API_KEY=

# (선택) 파이프라인 공통 설정 기본값 덮어쓰기
#PBR_NOW=2026-05-21 18
#PBR_PERIOD=25년 11월
#PBR_DURATION=_05_10
#PBR_RAW_FILE=data/raw_data/...csv
#PBR_DB_PATH=data/bike_system.db

# (선택) 모델 파라미터 — 기본값은 실측 실험으로 정했습니다 (docs/분석/EXPERIMENTS.md)
#PBR_TARGET_Z=1.99          # 목표 재고 안전계수: target_qty = mu + z·sigma
#PBR_CLUSTER_GAMMA=3000     # 군집 목적함수의 거리 가중치
#PBR_CLUSTER_ALPHA=1
#PBR_CLUSTER_BETA=100

# (선택) 차량 운용 (docs/구현/FLEET.md)
# 두 대수 모두 웹 실행 폼이나 run_pipeline.py --fleet-size / --vehicles-per-round
# 로도 정할 수 있습니다 (각 1~99).
#PBR_FLEET_SIZE=21
#PBR_VEHICLES_PER_ROUND=21   # 회차당 투입 '상한'(기본 = 보유 대수).
                            # 실제 대수는 그 회차의 작업량이 정합니다(실측 12~16대).
                            # 보유 대수보다 크게 적으면 보유 대수로 잘립니다
#PBR_TIME_BUDGET_MINUTES=120
#PBR_VEHICLE_SPEED_KMPH=25   # ILP와 VRP가 함께 쓰는 값 — 한쪽만 바꿀 수 없습니다
#PBR_PICK_TIME_SEC=30       # 자전거 1대 싣는 시간(초) — 현장 확인 안 된 가정값
#PBR_DROP_TIME_SEC=30       # 자전거 1대 내리는 시간(초) — 소요시간의 20~30%를 차지

# (선택) 작업 대상 선정·군집 조정 — **실험으로 정한 값이 아니라 관행값입니다**
#PBR_REBAL_MIN_QTY=2          # |rebal_qty|가 이 값 이하인 대여소는 손대지 않습니다
#PBR_TOP_STATION_LIMIT=50     # Pick·Drop 각각 상위 몇 곳까지 볼지
#PBR_ADJUST_MAX_ITER=200      # 군집 조정 반복 상한
#PBR_ADJUST_BALANCE_OK=3      # 모든 군집의 |수급 합|이 이 값 이하면 만족
#PBR_ADJUST_BALANCE_LIMIT=5   # 이 값을 넘는 군집은 재조정 대상

# (선택) 요일 구분 — 휴일 = 주말 + 공휴일 (docs/구현/steps/step0_raw.md)
#PBR_DAY_TYPE=auto          # auto | weekday | holiday. auto는 대상일을 달력으로 판정
#PBR_TARGET_DATE=2026-09-25 # 계획 대상일(기본 오늘). auto 판정의 기준

# (선택) 계절 수준 보정 — 계획 대상 달 첫 N일로 배율을 구한다 (docs/분석/EXPERIMENTS.md 3장)
#PBR_WARMUP_DAYS=14         # 0이면 끔
#PBR_WARMUP_PERIOD=26년 03월 # 기본: 계획 대상일의 달

# (선택) 날씨 원천 — 기상자료개방포털 ASOS 시간자료(대전 지점 133)
# 웹 화면(실행 폼 위 날씨 상자)과 demand_model.py(날씨 피처 하네스)가 읽습니다.
# 없어도 파이프라인은 그대로 돕니다 — 날씨는 있으면 좋고 없어도 되는 입력입니다.
# 이 키는 기상청 API 허브(https://apihub.kma.go.kr) 키이고, 실시간 관측(kma_sfctm2)에
# 씁니다. 과거 자료는 키 없이 기상자료개방포털 CSV로 받습니다 — 받는 방법은
# docs/분석/WEATHER.md 1장, data/raw_data/날씨/설명.txt.
#APIHUN_KMA_TYPE01_KEY=발급받은키

# 날씨 원천 경로입니다. 파일 하나여도 되고 디렉터리여도 됩니다(그 안의 CSV를 모두 읽습니다).
#PBR_WEATHER_FILE=data/raw_data/날씨

# (선택) TMAP 호출 제어 — 일일 한도가 있는 유료 API입니다 (docs/구현/steps/step3_visualization.md)
# 엔드포인트는 자동으로 고릅니다: routeSequential30을 먼저 쓰고, 일일 한도를
# 소진하면 routeSequential100으로 전환합니다(한도가 엔드포인트마다 따로 잡힙니다).
#PBR_TMAP_MAX_CALLS=35      # 한 실행의 호출 상한. 넘으면 남은 경로는 직선으로 그립니다
#PBR_TMAP_MAX_VIA=30        # 경유지 상한 강제(비우면 엔드포인트별 상한 30/100을 따름)
#PBR_TMAP_URL=https://apis.openapi.sk.com/tmap/routes/routeSequential100  # 지정 시 폴백 없음
