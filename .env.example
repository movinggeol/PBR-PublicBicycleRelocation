# 이 파일을 .env로 복사한 뒤 발급받은 키를 입력하세요. (.env는 Git에 포함되지 않습니다)

# TASHU Open API 키 — step0 tashu_api.py (https://bike.tashu.or.kr)
TASHU_API_KEY=

# TMAP API 키 — step3 main.py (https://tmapapi.tmapmobility.com)
API_KEY=

# (선택) 파이프라인 공통 설정 기본값 덮어쓰기
#PBR_NOW=2026-05-21 18
#PBR_PERIOD=25년 11월
#PBR_DURATION=_05_10
#PBR_RAW_FILE=data/raw_data/...csv
#PBR_DB_PATH=data/bike_system.db

# (선택) 모델 파라미터 — 기본값은 실측 실험으로 정했습니다 (docs/EXPERIMENTS.md)
#PBR_TARGET_Z=1.99          # 목표 재고 안전계수: target_qty = mu + z·sigma
#PBR_CLUSTER_GAMMA=3000     # 군집 목적함수의 거리 가중치
#PBR_CLUSTER_ALPHA=1
#PBR_CLUSTER_BETA=100

# (선택) 차량 운용 (docs/FLEET.md)
# 두 대수 모두 웹 실행 폼이나 run_pipeline.py --fleet-size / --vehicles-per-round
# 로도 정할 수 있습니다 (각 1~99).
#PBR_FLEET_SIZE=21
#PBR_VEHICLES_PER_ROUND=10   # 보유 대수보다 크면 보유 대수로 잘립니다
#PBR_TIME_BUDGET_MINUTES=120

# (선택) 요일 구분 — 휴일 = 주말 + 공휴일 (docs/steps/step0_raw.md)
#PBR_DAY_TYPE=auto          # auto | weekday | holiday. auto는 대상일을 달력으로 판정
#PBR_TARGET_DATE=2026-09-25 # 계획 대상일(기본 오늘). auto 판정의 기준

# (선택) 계절 수준 보정 — 계획 대상 달 첫 N일로 배율을 구한다 (docs/EXPERIMENTS.md 3장)
#PBR_WARMUP_DAYS=14         # 0이면 끔
#PBR_WARMUP_PERIOD=26년 03월 # 기본: 계획 대상일의 달

# (선택) 날씨 원천 — 기상자료개방포털 ASOS 시간자료(대전 지점 133)
# 파일이 없으면 날씨 없이 돕니다. data/raw_data/날씨/README.txt 참고
#PBR_WEATHER_FILE=data/raw_data/날씨/대전_ASOS_시간자료.csv

# (선택) TMAP 호출 제어 — 일일 한도가 있는 유료 API입니다 (docs/steps/step3_visualization.md)
# 엔드포인트는 자동으로 고릅니다: routeSequential30을 먼저 쓰고, 일일 한도를
# 소진하면 routeSequential100으로 전환합니다(한도가 엔드포인트마다 따로 잡힙니다).
#PBR_TMAP_MAX_CALLS=35      # 한 실행의 호출 상한. 넘으면 남은 경로는 직선으로 그립니다
#PBR_TMAP_MAX_VIA=30        # 경유지 상한 강제(비우면 엔드포인트별 상한 30/100을 따름)
#PBR_TMAP_URL=https://apis.openapi.sk.com/tmap/routes/routeSequential100  # 지정 시 폴백 없음
